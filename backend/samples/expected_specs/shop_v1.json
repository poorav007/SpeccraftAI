{
  "openapi": "3.0.3",
  "info": {
    "title": "FastAPI Shop API",
    "version": "1.0.0",
    "description": "Sample e-commerce shop backend used for SpecCraft AI AST extraction and OpenAPI generation."
  },
  "servers": [
    {
      "url": "/",
      "description": "Default server"
    }
  ],
  "tags": [
    {
      "name": "items"
    },
    {
      "name": "orders"
    },
    {
      "name": "system"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Service Health Check",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "tags": [
          "items"
        ],
        "summary": "List Catalog Items",
        "operationId": "list_items",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemResponse"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "items"
        ],
        "summary": "Create Catalog Item",
        "operationId": "create_item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/items/{item_id}": {
      "get": {
        "tags": [
          "items"
        ],
        "summary": "Get Single Item",
        "operationId": "get_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "items"
        ],
        "summary": "Update Item",
        "operationId": "update_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "items"
        ],
        "summary": "Delete Item",
        "operationId": "delete_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "List Orders",
        "operationId": "list_orders",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Create New Order",
        "operationId": "create_order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get Order Details",
        "operationId": "get_order",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemBase": {
        "title": "ItemBase",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Product title or catalog name"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Detailed product description"
          },
          "price": {
            "type": "number",
            "description": "Product price in USD"
          },
          "category": {
            "type": "string",
            "description": "Product category for filtering",
            "default": "general"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Search and categorization tags"
          }
        },
        "description": "Base item model with shared attributes.",
        "required": [
          "name",
          "price"
        ]
      },
      "ItemCreate": {
        "title": "ItemCreate",
        "type": "object",
        "properties": {},
        "description": "Payload required to create a new catalog item."
      },
      "ItemResponse": {
        "title": "ItemResponse",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique database identifier"
          },
          "in_stock": {
            "type": "boolean",
            "description": "Inventory availability flag",
            "default": true
          }
        },
        "description": "Public representation of a catalog item.",
        "required": [
          "id"
        ]
      },
      "OrderCreate": {
        "title": "OrderCreate",
        "type": "object",
        "properties": {
          "customer_email": {
            "type": "string",
            "description": "Customer contact email"
          },
          "shipping_address": {
            "type": "string",
            "description": "Physical delivery destination"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "description": "List of items in the order"
          }
        },
        "description": "Payload to initiate a new checkout order.",
        "required": [
          "customer_email",
          "shipping_address",
          "items"
        ]
      },
      "OrderItem": {
        "title": "OrderItem",
        "type": "object",
        "properties": {
          "item_id": {
            "type": "integer",
            "description": "Referenced catalog item ID"
          },
          "quantity": {
            "type": "integer",
            "description": "Number of units ordered",
            "default": 1
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit at purchase time"
          }
        },
        "description": "Item reference and quantity within an order.",
        "required": [
          "item_id",
          "unit_price"
        ]
      },
      "OrderResponse": {
        "title": "OrderResponse",
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Unique order tracking code"
          },
          "customer_email": {
            "type": "string",
            "description": "Customer contact email"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "description": "Current fulfillment status"
          },
          "total_amount": {
            "type": "number",
            "description": "Sum of all ordered items"
          },
          "items_count": {
            "type": "integer",
            "description": "Total quantity of products"
          }
        },
        "description": "Customer-facing order summary.",
        "required": [
          "order_id",
          "customer_email",
          "total_amount",
          "items_count"
        ]
      },
      "OrderStatus": {
        "title": "OrderStatus",
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped",
          "delivered",
          "cancelled"
        ],
        "description": "Lifecycle statuses for a customer order."
      },
      "ValidationError": {
        "title": "ValidationError",
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        }
      },
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    }
  }
}